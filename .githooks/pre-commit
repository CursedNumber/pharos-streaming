#!/usr/bin/env bash
# Pharos/Trireme pre-commit hook: keep the tree rustfmt-clean so CI's `fmt` step
# (which gates `clippy`) never goes red on formatting drift. Runs only when Rust
# files are staged, so docs-only / config-only commits are unaffected.
#
# Enabled per-clone with:  git config core.hooksPath .githooks
# Bypass a single commit with:  git commit --no-verify
set -uo pipefail

# Nothing to check unless a .rs file is part of this commit.
if ! git diff --cached --name-only --diff-filter=ACM | grep -q '\.rs$'; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found; skipping rustfmt check." >&2
    exit 0
fi

if ! cargo fmt --check >/dev/null 2>&1; then
    echo "" >&2
    echo "  ✗ pre-commit: rustfmt drift — CI's fmt step would fail." >&2
    echo "    Fix it and re-commit:" >&2
    echo "" >&2
    echo "        cargo fmt && git add -u" >&2
    echo "" >&2
    echo "    (or bypass this one commit with:  git commit --no-verify)" >&2
    echo "" >&2
    exit 1
fi

exit 0
