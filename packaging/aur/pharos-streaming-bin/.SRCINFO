pkgbase = pharos-streaming-bin
	pkgdesc = Clean-slate game-streaming stack in the Sunshine/Moonlight lineage (Pharos host + Trireme client, prebuilt)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/CursedNumber/pharos-streaming
	arch = x86_64
	license = GPL-3.0-or-later
	source = https://github.com/CursedNumber/pharos-streaming/releases/download/v0.2.0/pharos-0.2.0-linux-x86_64.tar.gz
	source = https://github.com/CursedNumber/pharos-streaming/releases/download/v0.2.0/trireme-0.2.0-linux-x86_64.tar.gz
	sha256sums = 4656feb3b9f9c72218ab9ee8b36de457641d5734c8d14cd0a1e30cc5152d38cb
	sha256sums = d0e29044477810e3c0fe52b2c7f882da778b6e78ca0f4287bc3c0f518167e319

pkgname = pharos-bin
	pkgdesc = Pharos game-streaming host (headless Wayland compositor + NVENC, prebuilt)
	depends = glibc
	depends = gcc-libs
	depends = nvidia-utils
	depends = mesa
	depends = libdrm
	depends = libxkbcommon
	depends = pixman
	depends = expat
	depends = opus
	depends = libpulse
	depends = pipewire
	optdepends = vulkan-driver: GPU-accelerated pharos-panel UI
	optdepends = xdg-desktop-portal: desktop-mirror mode (issue #6) — also needs a portal backend for your desktop (e.g. xdg-desktop-portal-kde/-gnome/-wlr)
	optdepends = xorg-xwayland: run X11 apps and games inside the stream
	optdepends = gamescope: Steam Big Picture session
	optdepends = steam: Steam Big Picture session
	optdepends = mpv: media-player app
	optdepends = ffmpeg: software VVC encode
	provides = pharos
	conflicts = pharos

pkgname = trireme-bin
	pkgdesc = Trireme game-streaming client for Pharos hosts (desktop + headless KMS players, USB export, prebuilt)
	depends = glibc
	depends = gcc-libs
	depends = mesa
	depends = libdrm
	depends = expat
	depends = opus
	depends = libusb
	depends = systemd-libs
	depends = ffmpeg
	depends = libpulse
	optdepends = vulkan-driver: GPU-accelerated presentation in the desktop player
	provides = trireme
	conflicts = trireme
