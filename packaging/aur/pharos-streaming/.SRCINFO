pkgbase = pharos-streaming
	pkgdesc = Clean-slate game-streaming stack in the Sunshine/Moonlight lineage (Pharos host + Trireme client)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/CursedNumber/pharos-streaming
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = nvidia-utils
	makedepends = mesa
	makedepends = libdrm
	makedepends = libxkbcommon
	makedepends = pixman
	makedepends = expat
	makedepends = opus
	makedepends = libusb
	makedepends = systemd-libs
	makedepends = clang
	makedepends = pipewire
	options = !lto
