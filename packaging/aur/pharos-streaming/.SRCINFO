	sha256sums = 1db7ef62aa6126e075f088040e7e08ab907dacc6026e3729d3bc033b8012dd7a

pkgname = pharos
	pkgdesc = Pharos game-streaming host (headless Wayland compositor + NVENC)
	depends = glibc
	depends = gcc-libs
	depends = nvidia-utils
	depends = mesa
	depends = libdrm
	depends = libxkbcommon
	depends = pixman
	depends = expat
	depends = opus
	depends = libpulse
	depends = pipewire
	optdepends = vulkan-driver: GPU-accelerated pharos-panel UI
	optdepends = xdg-desktop-portal: desktop-mirror mode (issue #6) — also needs a portal backend for your desktop (e.g. xdg-desktop-portal-kde/-gnome/-wlr)

pkgname = trireme
	pkgdesc = Trireme game-streaming client for Pharos hosts (desktop + headless KMS players)
	depends = glibc
	depends = gcc-libs
	depends = mesa
	depends = libdrm
	depends = expat
	depends = opus
	depends = libusb
	depends = systemd-libs
	depends = ffmpeg
	depends = libpulse
	optdepends = vulkan-driver: GPU-accelerated presentation in the desktop player
