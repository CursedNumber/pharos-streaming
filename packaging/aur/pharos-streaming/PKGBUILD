# Maintainer: CursedNumber <16852735+CursedNumber@users.noreply.github.com>
#
# Source split package: builds the Pharos host and the Trireme client from the
# tagged GitHub release tarball. The binary counterpart (release assets, no
# compile) lives in pharos-streaming-bin.
#
# Before pushing to the AUR: run `updpkgsums` against the real tag tarball
# (sha256sums below is SKIP until the tag exists), then regenerate .SRCINFO
# with `makepkg --printsrcinfo > .SRCINFO`.

pkgbase=pharos-streaming
pkgname=(pharos trireme)
pkgver=0.1.0
pkgrel=1
pkgdesc="Clean-slate game-streaming stack in the Sunshine/Moonlight lineage (Pharos host + Trireme client)"
arch=(x86_64)
url="https://github.com/CursedNumber/pharos-streaming"
license=(GPL-3.0-or-later)
# nvidia-utils supplies the libnvidia-encode.so / libnvcuvid.so the NVENC
# crate links against; opus must be the system lib so pkg-config finds it
# (otherwise the bundled copy is built, needlessly). clang + pipewire are for
# the desktop-mirror capture path (issue #6, `portal-mirror` feature — ON by
# default): pipewire-rs's sys crate needs libpipewire-0.3 headers + clang at
# build time.
makedepends=(rust nvidia-utils mesa libdrm libxkbcommon pixman expat opus libusb systemd-libs clang pipewire)
# !lto: makepkg's -flto=auto turns ring's C objects into GCC-LTO bitcode that
# rust-lld cannot read -> every ring_core_* symbol undefined at link.
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1db7ef62aa6126e075f088040e7e08ab907dacc6026e3729d3bc033b8012dd7a')

prepare() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen \
    -p compositor -p pharos-panel -p pharos-tray -p usbip-host \
    -p trireme -p trireme-kms -p usbip-export
}

package_pharos() {
  pkgdesc="Pharos game-streaming host (headless Wayland compositor + NVENC)"
  depends=(glibc gcc-libs nvidia-utils mesa libdrm libxkbcommon pixman expat opus libpulse pipewire)
  optdepends=(
    'vulkan-driver: GPU-accelerated pharos-panel UI'
    'xdg-desktop-portal: desktop-mirror mode (issue #6) — also needs a portal backend for your desktop (e.g. xdg-desktop-portal-kde/-gnome/-wlr)'
    'xorg-xwayland: run X11 apps and games inside the stream'
    'gamescope: Steam Big Picture session'
    'steam: Steam Big Picture session'
    'mpv: media-player app'
    'ffmpeg: software VVC encode'
  )

  cd "$pkgbase-$pkgver"
  install -Dm755 target/release/pharos-{compositor,panel,tray,usbimport} \
    -t "$pkgdir/usr/bin"
  install -Dm644 packaging/systemd/pharos-{host,tray}.service \
    -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 packaging/systemd/pharos-usbimport.service \
    -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 packaging/desktop/pharos-panel.desktop \
    -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/udev/60-pharos.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 packaging/modules-load/pharos.conf -t "$pkgdir/usr/lib/modules-load.d"
  install -Dm644 packaging/icons/pharos.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/pharos.png"
}

package_trireme() {
  pkgdesc="Trireme game-streaming client for Pharos hosts (desktop + headless KMS players, USB export)"
  depends=(glibc gcc-libs mesa libdrm expat opus libusb systemd-libs ffmpeg libpulse)
  optdepends=(
    'vulkan-driver: GPU-accelerated presentation in the desktop player'
  )

  cd "$pkgbase-$pkgver"
  install -Dm755 target/release/trireme{,-kms,-usbexport} -t "$pkgdir/usr/bin"
  install -Dm644 packaging/desktop/trireme.desktop \
    -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/icons/trireme.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/trireme.png"
}
