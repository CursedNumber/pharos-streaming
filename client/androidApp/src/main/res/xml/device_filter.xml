<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices Trireme offers to auto-handle on attach. Scoped narrowly to the
     controllers enrolled for USB/IP export so Android only prompts "Open Trireme?
     [use by default]" for THESE — never for the TV remote or other peripherals
     (the catch-all <usb-device/> that did was the source of the per-plug pop-up).

     Ticking "use by default" once writes a *persistent* USB-permission grant, so
     later reconnects auto-forward silently (no dialog). vendor-id/product-id are
     DECIMAL here. Add a line per controller you export.

       1118:654   = 045e:028e  Flydigi Vader (XInput / Xbox 360 mode)
       1204:9234  = 04b4:2412  Flydigi Vader (Cypress bridge / NS composite mode)
       1406:8201  = 057e:2009  Switch Pro / Flydigi Vader (NS mode)
       9047:1540  = 2357:0604  TP-LINK USB Bluetooth dongle (verify on device) -->
<resources>
    <usb-device vendor-id="1118" product-id="654" />
    <usb-device vendor-id="1204" product-id="9234" />
    <usb-device vendor-id="1406" product-id="8201" />
    <usb-device vendor-id="9047" product-id="1540" />
</resources>
