<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell's platform window theme. The actual UI colors come from the Compose
  TriremeTheme (a branded nautical Material3 scheme that follows the system
  dark/light setting via isSystemInDarkTheme()); this XML theme only governs the
  window itself — it must be NoActionBar (no generic "Trireme" banner) and
  fullscreen so the SurfaceView renders edge-to-edge before Compose even draws.

  Parent is the PLATFORM Material NoActionBar.Fullscreen theme (present since API
  21, this module's minSdk is 26): it needs NO extra Gradle dependency (the app
  pulls in Compose + core-ktx only, not appcompat/material-components), is dark by
  default — right for a dark TV room — and carries no title bar. A dark window
  background also avoids a light flash before the dark Compose UI mounts.
-->
<resources>
    <style name="Theme.Trireme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Behind the video before the first frame / behind the navbar scrim. -->
        <item name="android:windowBackground">@color/window_backdrop</item>
    </style>
</resources>
